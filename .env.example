# =====================================================================
# Vaani Duplex: Environment Configuration
# =====================================================================

# 1. Groq API Configuration (REQUIRED for 100% Free Mode)
# Obtain a free key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_paste_your_free_groq_key_here

# 2. Sarvam AI Configuration (OPTIONAL - for Indic Native Models)
# Obtain a key at: https://dashboard.sarvam.ai
SARVAM_API_KEY=

# 3. Speech Pipeline Mode
# Options:
#   - free: Groq Whisper-large-v3-turbo (ASR) + Microsoft Edge-TTS (TTS) (₹0 / 100% Free)
#   - sarvam: Sarvam Saaras:v4 (ASR) + Sarvam Bulbul:v3 (TTS) (Paid / Trial)
SPEECH_PROVIDER=free

# 4. Groq LLM Models
GROQ_PRIMARY_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_MODEL=llama-3.1-8b-instant

# 5. Silero VAD & Full-Duplex Timing Parameters
# VAD Probability threshold for voiced speech [0.0 - 1.0]
VAD_THRESHOLD=0.65

# Minimum continuous voiced frames to register genuine user barge-in (6 frames * 32ms = 192ms)
# Shorter sounds (<192ms like "haan", "hmm", "avunu") are treated as backchannels and do NOT interrupt
BARGE_IN_MIN_FRAMES=6

# Trailing silence frames to detect user end-of-turn (18 frames * 32ms = 576ms)
SILENCE_END_FRAMES=18
